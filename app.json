{
  "expo": {
    "name": "Лостове Наблизо",
    "slug": "street-fitnes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "streetfitnes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.streetfitnes.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.streetfitnes.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "„Лостове Наблизо“ използва локацията ти, за да постави добавеното от теб място там, където стоиш."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
