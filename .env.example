# Environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored, so it never
# leaves your machine. Commit `.env.example` (this file) unchanged.
#
#   cp .env.example .env      # Windows PowerShell: Copy-Item .env.example .env
#
# The `EXPO_PUBLIC_` prefix is required: Expo inlines these values into the JavaScript
# bundle at build time. Everything prefixed this way is PUBLIC. Anyone with the app can
# read it. Never put a private key, service-role key or admin token behind this prefix.
#
# The three values below are public by design and are safe to ship to the client:
#   - the Supabase publishable key is protected by Row Level Security, and Supabase Auth is
#     the identity provider, so there is no second auth key to configure
#   - the Sentry DSN only allows submitting events to one project
# Restart the dev server after changing any value.

# ─── Supabase ────────────────────────────────────────────────────────────────────
# Dashboard → your project → Project Settings → API
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# The "publishable" key from the same page (sb_publishable_...). Legacy "anon" keys still work.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7aBtLb90-LtST3WUvRssJg_Tx11u4xY


# ─── Sentry (optional) ───────────────────────────────────────────────────────────
# Project Settings → Client Keys (DSN). Leave empty to disable error monitoring.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Analytics (optional) ────────────────────────────────────────────────────────
# Off by default. Accepts true/false, 1/0, yes/no, on/off.
EXPO_PUBLIC_ANALYTICS_ENABLED=false
# Set to true to log analytics events to the console while developing.
EXPO_PUBLIC_ANALYTICS_DEBUG=false
